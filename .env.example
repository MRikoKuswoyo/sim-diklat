# Untuk Laragon (MySQL) — sesuaikan nama database & password kalau beda
DATABASE_URL="mysql://root:@localhost:3306/sim_diklat"

# Kalau kamu pakai PostgreSQL (bukan Laragon default), ganti provider di
# prisma/schema.prisma kembali ke "postgresql" dan format URL-nya:
# DATABASE_URL="postgresql://user:password@localhost:5432/sim_diklat?schema=public"

# Untuk menandatangani session JWT (login)
JWT_SECRET="ganti-dengan-string-acak-panjang"

# --- Integrasi Moodle ---
# Alamat Moodle (tanpa garis miring di akhir). Cukup ini saja -> tombol Moodle membuka Moodle.
MOODLE_URL="http://localhost"
# Token untuk MASUK OTOMATIS ke Moodle. Dicetak oleh skrip pasang-sso.bat (lihat PANDUAN-MOODLE.md).
# Kosongkan kalau belum dipasang.
MOODLE_WS_TOKEN=""

# Alamat aplikasi untuk kode QR verifikasi (isi domain asli saat dipasang)
# APP_URL="https://diklat.contoh.go.id"

# Zona waktu jadwal sesi untuk batas waktu absen (default WIB)
# ZONA_WAKTU="+07:00"

# --- Keamanan ---
# JWT_SECRET WAJIB diganti dengan teks acak minimal 32 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Pada mode produksi, aplikasi menolak login jika JWT_SECRET masih contoh/terlalu pendek.

# --- Email notifikasi (OPSIONAL) ---
# Tanpa ini, notifikasi tetap muncul di lonceng dalam aplikasi. Isi untuk ikut mengirim email.
# Contoh Gmail: gunakan "App Password" (bukan kata sandi biasa).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="akun@gmail.com"
# SMTP_PASS="app-password"
# SMTP_FROM="SIM Diklat <akun@gmail.com>"
